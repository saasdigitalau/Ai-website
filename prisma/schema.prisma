generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  clerkId       String    @unique
  email         String?
  name          String?
  plan          String    @default("free") // free, starter, pro, business
  stripeCustomerId String?
  stripeSubscriptionId String?
  subscriptionStatus String? // active, past_due, canceled, etc.
  aiCredits     Int       @default(0)
  whiteLabel    Boolean   @default(false) // Remove SiteLaunch branding from client portal
  whiteLabelLogo String?  // Custom logo URL for white-label
  whiteLabelDomain String? // Custom domain for client portal
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  websites  Website[]
  invoices  Invoice[]
  leads     LeadSearch[]
  clients   Client[]
}

model Website {
  id          String   @id @default(cuid())
  userId      String?
  name        String
  description String
  businessType String
  html        String
  published   Boolean  @default(false)
  approved    Boolean  @default(false) // Client approval status
  customDomain String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id])
  clients  Client[]
  feedback Feedback[]
  blogPosts BlogPost[]
  seoResult SeoResult?
  socialSnippets SocialSnippet[]
}

model Client {
  id          String    @id @default(cuid())
  userId      String    // The freelancer who owns this client
  name        String
  email       String
  inviteCode  String    @unique
  websiteId   String?
  approved    Boolean   @default(false)
  viewedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user     User?     @relation(fields: [userId], references: [id])
  website  Website?  @relation(fields: [websiteId], references: [id])
  feedback Feedback[]
}

model Feedback {
  id        String   @id @default(cuid())
  clientId  String
  websiteId String
  message   String
  type      String   @default("comment") // comment, revision, approval
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  client  Client  @relation(fields: [clientId], references: [id])
  website Website @relation(fields: [websiteId], references: [id])
}

model Invoice {
  id          String   @id @default(cuid())
  userId      String
  clientName  String
  clientEmail String
  amount      Int      // amount in cents
  status      String   @default("pending") // pending, sent, paid, overdue
  invoiceNumber String @unique
  lineItems   Json?
  dueDate     DateTime?
  notes       String?
  pdfUrl      String?
  stripePaymentLink String?
  stripePaymentLinkId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model LeadSearch {
  id        String   @id @default(cuid())
  userId    String
  query     String
  location  String?
  results   Json?
  count     Int      @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model BlogPost {
  id          String   @id @default(cuid())
  websiteId   String
  title       String
  slug        String   @unique
  content     String
  excerpt     String?
  coverImage  String?
  tags        String?
  status      String   @default("draft") // draft, published
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  website Website @relation(fields: [websiteId], references: [id])
}

model SeoResult {
  id              String   @id @default(cuid())
  websiteId       String
  score           Int      // Overall score 0-100
  metaTitleScore  Int      @default(0)
  metaDescScore   Int      @default(0)
  headingScore    Int      @default(0)
  imageAltScore   Int      @default(0)
  mobileScore     Int      @default(0)
  speedScore      Int      @default(0)
  keywordScore    Int      @default(0)
  checks          Json     // Array of check results {name, passed, suggestion}
  suggestions     Json?    // Array of improvement suggestions
  rawHtml         String?  // The HTML that was analyzed
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  website Website @relation(fields: [websiteId], references: [id])

  @@unique([websiteId])
}

model SocialSnippet {
  id             String   @id @default(cuid())
  websiteId      String
  platform       String   // instagram, twitter, linkedin, facebook
  content        String
  characterCount Int
  hashtags       String?  // Comma-separated hashtags
  createdAt      DateTime @default(now())

  website Website @relation(fields: [websiteId], references: [id])
}