# Clerk Auth
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Database (PostgreSQL via Prisma)
DATABASE_URL="postgresql://postgres:password@localhost:5432/sitelaunch?schema=public"

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Billing (provider + currency). Razorpay is the live provider; Stripe is
# kept alongside and dormant. Provider auto-detects from credentials unless
# PAYMENT_PROVIDER is set explicitly to razorpay | stripe | none.
PAYMENT_PROVIDER=
# Currency customers are charged in (lowercase ISO). Defaults to "usd".
# If you switch away from usd, supply per-plan amounts below.
PAYMENT_CURRENCY=

# Razorpay (live provider)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Razorpay subscription plan ids (created in the Razorpay dashboard).
# When a plan id is absent, checkout falls back to a one-time payment.
RAZORPAY_STARTER_PLAN_ID=
RAZORPAY_PRO_PLAN_ID=
RAZORPAY_BUSINESS_PLAN_ID=
# Per-plan amounts in the configured currency's smallest unit (paise for INR,
# cents for USD). Only required when PAYMENT_CURRENCY != usd.
#RAZORPAY_STARTER_AMOUNT_MINOR=
#RAZORPAY_PRO_AMOUNT_MINOR=
#RAZORPAY_BUSINESS_AMOUNT_MINOR=

# Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000